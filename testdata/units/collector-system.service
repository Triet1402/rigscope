# Managed by rigscope. Do not edit; run "rigscope install" to rewrite.
# Component: collector; scope: system
[Unit]
Description=Rigscope collector
Documentation=https://rigscope.dev/docs
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=rigscope-collector
Group=rigscope
WorkingDirectory=/var/lib/rigscope/collector
ExecStart="/usr/local/bin/rigscope" collector --config "/etc/rigscope/config.json"
Restart=on-failure
RestartSec=2s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SupplementaryGroups=rigscope-rapl rigscope-gpu
ReadWritePaths="/var/lib/rigscope/collector"
ReadOnlyPaths="/usr/local/bin/rigscope"
TimeoutStopSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rigscope-collector

[Install]
WantedBy=multi-user.target
