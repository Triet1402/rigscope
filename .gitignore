node_modules/
# Linked node_modules directories are symlinks, which the directory pattern
# misses.
/node_modules
/website/node_modules
.next/
.next-dev/
out/
*.tsbuildinfo
next-env.d.ts

.env
.env.*

# Private local enrollment examples
/.*-local/

# Local collaboration instructions
/AGENTS.md

# Local release archives from scripts/release/build.sh
/build/
/*.tar.gz
/*.tgz
/*.tar.gz.manifest.json
/dist/

# Local design tooling
.impeccable/

# Local stress-test logs and per-process resource traces.
# Keep the report, measurement JSON, index, chart and manifest versioned.
/docs/stress-*/*.log
/docs/stress-*/*.resources.json
# Copied static UI export embedded by internal/hub/webui. The placeholder
# keeps `//go:embed all:dist` compiling before `npm run build:ui` has run.
# The generated files are not committed; re-include the package directory and
# its placeholder.
!/internal/hub/webui/dist/
/internal/hub/webui/dist/*
!/internal/hub/webui/dist/.keep
