# Hub environment example
#
# Copy the values you need into the private hub.env created by the installer
# (mode 0600), not into a repository file. The generated hub.env starts with
# every value commented out: no browser users and no collector credentials
# means protected browser data fails closed.
#
# PUBLIC DEMO VALUES ONLY below. Never use demo-token-local for a real host,
# never reuse a demo browser password, and never put credentials in URLs.

# Loopback-only development listener.
# HUB_HOST=127.0.0.1
# HUB_PORT=8081

# Remote mode is selected only when both are set. The socket must live under a
# private directory (the installer's state directory is writable by the unit).
# HUB_PUBLIC_ORIGIN=https://monitor.example.invalid
# HUB_SOCKET_PATH=/home/operator/.local/state/rigscope/run/hub.sock

# Browser access fails closed without this. Generate the real hash locally with
# scripts/hash-browser-password.cjs; never paste a plaintext password here.
# HUB_BROWSER_USERS=[{"username":"operator","passwordHash":"<private hash>","machineIds":"*"}]

# Static collector credentials (public demo shape/token).
# HUB_COLLECTORS=[{"collectorId":"demo-collector","machineId":"demo-machine","token":"demo-token-local"}]

# Enrollment/registry state. The installer sets HUB_DATABASE_PATH in the unit;
# keep enrollment state outside the repository, and HUB_STATE_FILE also serves
# as the recovery import source for previously enrolled collectors.
# HUB_STATE_FILE=/home/operator/.local/state/rigscope/hub/enrollment.json
# HUB_ENROLLMENT_GRANTS=[{"token":"<one-use grant>","expiresAt":"<ISO timestamp>"}]
