# Managed by `rigscope system`. Enable explicitly after enrollment.
# Independent component: enabling or restarting this unit never touches the hub.
# The collector is nologin and has no capability grants.
# Package power reads use the private group rule installed separately.
# Node receives no capabilities, no root, and no device-control access.
[Unit]
Description=Rigscope collector (system scope)
Documentation=file:/opt/rigscope/current/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=rigscope-collector
Group=rigscope-collector
WorkingDirectory=/opt/rigscope/current
EnvironmentFile=/etc/rigscope/collector.env
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=2s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ExecStart="/opt/rigscope/node/node" "/opt/rigscope/current/dist/collector.cjs" --await-connection
SupplementaryGroups=rigscope-rapl
Environment="COLLECTOR_MODE=real"
Environment="COLLECTOR_STATE_FILE=/var/lib/rigscope/collector/state.json"
Environment="COLLECTOR_HEALTH_FILE=/var/lib/rigscope/collector/health.json"
ReadWritePaths="/var/lib/rigscope/collector"
ReadOnlyPaths="/opt/rigscope/current"
TimeoutStopSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rigscope-collector

[Install]
WantedBy=multi-user.target
